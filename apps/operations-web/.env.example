# apps/operations-web — public browser env contract.
#
# These are the only env values the governed browser shell consumes. All are NEXT_PUBLIC_*
# (safe to expose to the client) and are inlined at build / dev-start, so restart Next after
# changing them. Copy this file to `.env.local` (gitignored) and fill in for local/dev runs.

# Supabase browser client (governed shell read surface).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Governed control-plane API base URL. Local default when the API is run per
# apps/control-plane-api/README.md is http://127.0.0.1:8010 (NOT the :8000 code fallback).
NEXT_PUBLIC_CONTROL_PLANE_BASE_URL=http://127.0.0.1:8010

# Dev-only PM actor for /pm-review/recognition + /pm-review/estimator-intake.
# Must be a REAL ops.persons(person_id) UUID on the target ops DB — attested_by / recognized_by /
# uploaded_by / approved_by all FK to it. If unset, the code falls back to a placeholder UUID the
# DB rejects, so attest/recognize/intake POSTs fail loudly rather than mis-attributing.
NEXT_PUBLIC_OPS_DEV_PM_ID=

# Note: the server-side rewrite target MUTATION_SEAM_BASE_URL (used by next.config.ts for
# /api/v1/{reads,schedule,mutations}/*) is NOT a public var — see apps/operations-web/DEPLOYMENT_VALIDATION.md.
