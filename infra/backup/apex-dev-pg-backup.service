[Unit]
Description=APEX dev-lanes Postgres nightly logical backup
Documentation=https://github.com/APEX-Power-Ops/apex-power-ops-platform
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=olares
Group=olares
SupplementaryGroups=docker
ExecStart=/usr/local/bin/apex-dev-pg-backup.sh
Nice=10
IOSchedulingClass=idle
