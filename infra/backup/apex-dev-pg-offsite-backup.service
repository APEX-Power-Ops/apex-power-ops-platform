[Unit]
Description=APEX dev-pg Offsite Backup (restic -> Backblaze B2)
Wants=network-online.target
After=network-online.target apex-dev-pg-backup.service
StartLimitIntervalSec=6h
StartLimitBurst=2

[Service]
Type=oneshot
User=olares
Group=olares
ExecStart=/home/olares/code/apex/apex-power-ops-platform/infra/backup/apex-dev-pg-offsite-backup.sh
WorkingDirectory=/home/olares
NoNewPrivileges=yes
Nice=10
UMask=0077
StandardOutput=append:/home/olares/apex-logs/dev-pg/apex-dev-pg-offsite-backup.log
StandardError=append:/home/olares/apex-logs/dev-pg/apex-dev-pg-offsite-backup.log
